*
!.gitignore

!src/
!src/**/
!src/**/*.rs

!python/
!python/adaptif/
!python/adaptif/*.py
!python/adaptif/*.pyi

# python unit tests
!python/tests/
!python/tests/**/*.py

# integration tests specifics
!integration/
!integration/**/
!integration/**/*.rs
!integration/**/*.py
# wav files by name
!integration/**/clean_speech_1.wav
!integration/**/clean_speech_2.wav

!examples/
!examples/**/
!examples/**/*.rs

!Cargo.toml
!Cargo.lock
!rust-toolchain.toml

# uv
!pyproject.toml
!uv.lock

!Makefile

# docs
!*.md
!LICENSE-APACHE
!LICENSE-MIT

# ci/cd
!.github/
!.github/**/
!.github/**/*.yml
!.github/**/*.md
!.pre-commit-config.yaml

# explicit excludes
**/__pycache__/
